{
  "name": "accessbit",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/remove-function-constroctor.js",
    "postbuild": "node scripts/remove-function-constroctor.js",
    "pack": "xcopy /E /I /Q /Y src dist\\src\\ && cd dist && bestzip ../plugin.zip * && cd .. && rmdir /S /Q dist\\src",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx"
    
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bestzip": "^3.0.1",
    "eslint": "^8.5.7",
    "eslint-plugin-promise": "^6.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@jaames/iro": "^5.5.2",
    "@tanstack/react-query": "^5.87.4",
    "framer-plugin": "^3.10.3",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-plugin-framer": "^1.1.1",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
